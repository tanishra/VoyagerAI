# Backend API URL (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend API Auth Key (Required in production when AUTH_MODE=production on Hugging Face Spaces)
# Must match API_AUTH_KEY in backend environment / Space secrets. Optional in local development.
NEXT_PUBLIC_API_AUTH_KEY=

# Google Maps JavaScript API key — renders the itinerary map.
# Enable "Maps JavaScript API" in your GCP project; restrict by HTTP referrer
# (e.g. localhost:3000, your domain). Optional: without it the map shows a
# link-list fallback instead of a broken/embedded map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

