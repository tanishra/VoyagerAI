# ─── LLM Provider Config (LiteLLM) ──────────────────────────────
# Model strings use LiteLLM format: "provider/model-name"
# Examples: gemini/gemini-3.7-flash, openai/gpt-4o, anthropic/claude-sonnet-4-20250514

# Orchestrator model (stronger, used for main agent + structured output)
LLM_ORCHESTRATOR_MODEL=gemini/gemini-3.7-flash
# Fallback model if primary fails (optional, leave empty to disable)
LLM_ORCHESTRATOR_FALLBACK=

# Subagent model (faster/cheaper, used for research/validation/enrichment)
LLM_SUBAGENT_MODEL=gemini/gemini-3.5-flash-lite
LLM_SUBAGENT_FALLBACK=

# Temperature settings (must be 1.0 for Gemini 3+ models)
LLM_TEMPERATURE_ORCHESTRATOR=1.0
LLM_TEMPERATURE_SUBAGENT=1.0

# ─── Provider API Keys ──────────────────────────────────────────
# Set the key(s) for the provider(s) you use above
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Use Vertex AI instead of Gemini API (default: false)
GOOGLE_GENAI_USE_VERTEXAI=false

# Google Maps Platform — Geocoding API key (server-side).
# Enable "Geocoding API" in your GCP project; restrict by server IP.
# Optional: when unset, geocoding falls back to free Nominatim.
GOOGLE_MAPS_API_KEY=

# ─── App Config ─────────────────────────────────────────────────

# API key for auth in production mode
API_AUTH_KEY=

# Auth mode: "development" (bypass) or "production" (enforce)
AUTH_MODE=development

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:3000

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Request timeout in seconds (default: 300)
REQUEST_TIMEOUT_SECONDS=300

# Tavily API key for internet search
TAVILY_API_KEY=

# LangSmith API key for tracing & evaluation
LANGSMITH_API_KEY=

# LangSmith project name (default: voyagerai)
LANGSMITH_PROJECT=voyagerai

# Checkpointer backend: "redis", "sqlite", or "memory" (default: redis)
CHECKPOINTER_BACKEND=redis

# SQLite checkpoint file (used when CHECKPOINTER_BACKEND=sqlite, or as the
# fallback when the Redis checkpointer cannot be initialized)
CHECKPOINTER_DB_PATH=./data/checkpoints.sqlite
# Root dir for SQLite files — set to a persistent mount in production, or
# leave empty to auto-detect a writable /data mount (HF Spaces, k8s).
DATA_DIR=

# Store backend: "redis" (default: redis)
STORE_BACKEND=redis

# SQLite fallback for all Redis-backed stores (threads, shares, sessions, etc.)
# Used when Redis is unavailable — data persists across restarts.
# Single-server only; multi-server production requires Redis.
SQLITE_FALLBACK_DB_PATH=./data/stores.sqlite

# Share link TTL in days (default: 7)
SHARE_TTL_DAYS=7

# Thread metadata TTL in days (default: 30)
THREAD_TTL_DAYS=30

# ─── OAuth / Sessions ───────────────────────────────────────────
# Google OAuth 2.0 credentials (required for production auth)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Session secret key — MUST be set to a strong random string in production
SESSION_SECRET_KEY=dev-only-insecure-key-change-in-production

# Comma-separated list of admin email addresses (grants access to /admin/* endpoints)
ADMIN_EMAILS=

# ─── Rate Limiting & Cost Caps (Phase 7.2) ──────────────────────
# Per-user rate limits (requests per minute, Redis-backed with SQLite fallback)
RATE_LIMIT_CHAT_PER_MIN=10
RATE_LIMIT_THREADS_PER_MIN=30
RATE_LIMIT_UPLOADS_PER_MIN=5

# Per-user daily cost cap in USD (blocks chat when exceeded)
DAILY_COST_CAP_USD=5.0

# Global circuit breaker: platform-wide hourly spend cap in USD
# Returns 503 for all chat requests when exceeded
HOURLY_PLATFORM_CAP_USD=50.0
CIRCUIT_BREAKER_ENABLED=true

# ─── Observability (Phase 7.4) ───────────────────────────────
# Log format: "json" (for Datadog/CloudWatch/ELK) or "text" (for dev)
LOG_FORMAT=json
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Prometheus /metrics endpoint (disable to hide metrics)
PROMETHEUS_ENABLED=true
# Alert threshold: warn when daily platform spend reaches this % of daily cap
ALERT_DAILY_THRESHOLD_PCT=0.8
